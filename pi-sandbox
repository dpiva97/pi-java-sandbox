#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: pi-sandbox [--docker] [--rebuild] [--shell] [--add-dir DIR]... [-- ARGS...]' \
    '' \
    'Run pi with JDK 25 in the current project directory (WSL).' \
    '  --docker   Share the Docker socket for Testcontainers (trusted projects only).' \
    '  --rebuild  Rebuild the image, update host Git checkouts and reinstall Pi packages.' \
    '  --shell    Open Bash in the container instead of pi.' \
    '  --add-dir DIR  Mount an extra directory read/write at the same absolute path (repeatable).' \
    '  --help     Show this help.' \
    '  --         Forward the remaining arguments to pi (or Bash with --shell).'
}

fail() {
  printf 'pi-sandbox: %s\n' "$*" >&2
  exit 1
}

with_docker=false
rebuild=false
shell=false
extra_dirs=()
while (($#)); do
  case "$1" in
    --docker) with_docker=true ;;
    --rebuild) rebuild=true ;;
    --shell) shell=true ;;
    --add-dir)
      (($# >= 2)) && [[ -n "$2" && "$2" != --* ]] || fail '--add-dir requires a directory path.'
      extra_dirs+=("$2")
      shift
      ;;
    --add-dir=*)
      [[ -n "${1#--add-dir=}" ]] || fail '--add-dir requires a directory path.'
      extra_dirs+=("${1#--add-dir=}")
      ;;
    --help|-h) usage; exit 0 ;;
    --) shift; break ;;
    *) fail "Unknown option: $1. Use --help or -- before pi/Bash arguments." ;;
  esac
  shift
done

# Resolve symlinks so ~/.local/bin/pi-sandbox still builds from this repository.
script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo_dir=$(dirname -- "$script_path")
project_dir=$(pwd -P)
image=pi-java-sandbox
[[ "$project_dir" != *,* ]] || fail 'Project paths containing commas are not supported by Docker --mount.'
command -v docker >/dev/null 2>&1 || fail 'Docker CLI not found. Enable Docker Desktop WSL integration.'

run_args=(
  --rm -it --init
  --mount "type=bind,source=$project_dir,target=$project_dir"
  --workdir "$project_dir"
  --mount type=volume,source=pi-agent-home,target=/home/node/.pi/agent
  --mount type=volume,source=pi-maven-cache,target=/home/node/.m2
)

# Canonical paths preserve host/container path equality, including symlink inputs.
# Avoid duplicate Docker mount targets (also when the project is added explicitly).
mounted_dirs=("$project_dir")
for dir in "${extra_dirs[@]}"; do
  [[ "$dir" != *,* ]] || fail 'Additional directory paths containing commas are not supported.'
  [[ -d "$dir" ]] || fail "Additional directory does not exist or is not a directory: $dir"
  dir=$(readlink -f -- "$dir") || fail "Cannot resolve additional directory: $dir"
  [[ "$dir" != *,* ]] || fail 'Resolved additional directory paths containing commas are not supported.'
  duplicate=false
  for mounted_dir in "${mounted_dirs[@]}"; do
    if [[ "$dir" = "$mounted_dir" ]]; then
      duplicate=true
      break
    fi
  done
  if ! "$duplicate"; then
    run_args+=(--mount "type=bind,source=$dir,target=$dir")
    mounted_dirs+=("$dir")
  fi
done

if "$with_docker"; then
  socket=${PI_SANDBOX_DOCKER_SOCKET:-/var/run/docker.sock}
  [[ -S "$socket" ]] || fail "Docker socket not found at $socket. Enable Docker Desktop WSL integration."
  socket=$(readlink -f -- "$socket")
  [[ "$socket" != *,* ]] || fail 'Docker socket paths containing commas are not supported.'
  socket_gid=$(stat -c %g -- "$socket")
  printf '%s\n' 'WARNING: --docker gives pi control over the host Docker daemon. Use only with trusted projects.' >&2
  run_args+=(
    --mount "type=bind,source=$socket,target=/var/run/docker.sock"
    --group-add "$socket_gid"
    --env TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
  )
fi

docker info >/dev/null 2>&1 || fail 'Docker daemon is unavailable. Start Docker Desktop and enable WSL integration.'

# Resolve Git sources on the host, where credential helpers and SSH are available.
# Stable container paths let Pi retain package settings across launches.
packages_dir=${PI_SANDBOX_PACKAGES_DIR:-${HOME:?HOME must be set}/.local/share/pi-sandbox/packages}
[[ "$packages_dir" = /* && "$packages_dir" != *,* ]] || fail 'Packages directory must be an absolute path without commas.'
packages=''
while IFS= read -r source <&3 || [[ -n "$source" ]]; do
  [[ -z "$source" || "$source" = \#* ]] && continue
  case "$source" in
    https://*|http://*|ssh://*|git://*|git@*|git:*)
      command -v git >/dev/null 2>&1 || fail 'Git is required on the host to install Git packages.'
      git_url=$source
      if [[ "$git_url" = git:* && "$git_url" != git://* ]]; then
        git_url=${git_url#git:}
        [[ "$git_url" = *://* || "$git_url" = git@* ]] || git_url="https://$git_url"
      fi
      # Pi refs use @ after the repository path (not the SSH user separator).
      git_ref=''
      if [[ "${git_url##*/}" = *@* ]]; then
        git_ref=${git_url##*@}
        git_url=${git_url%@*}
        [[ -n "$git_ref" ]] || fail "Empty Git ref: $source"
      fi
      package_id=$(printf '%s' "$source" | sha256sum)
      package_id=${package_id%% *}
      checkout="$packages_dir/$package_id"
      checkout_ref=false
      if [[ ! -e "$checkout" ]]; then
        checkout_ref=true
        mkdir -p -- "$packages_dir"
        git clone -- "$git_url" "$checkout" || fail 'Git package clone failed. Configure Git authentication on the host and retry.'
      elif [[ ! -e "$checkout/.git" ]]; then
        fail "Package directory is not a Git checkout: $checkout"
      elif "$rebuild"; then
        checkout_ref=true
        if [[ -n "$git_ref" ]]; then
          git -C "$checkout" fetch origin || fail 'Git package fetch failed. Check host authentication and retry.'
        else
          git -C "$checkout" pull --ff-only || fail 'Git package update failed. Check host authentication and local changes.'
        fi
      fi
      if "$checkout_ref" && [[ -n "$git_ref" ]]; then
        git -C "$checkout" checkout --detach "$git_ref" || fail "Git package ref checkout failed: $git_ref"
      fi
      checkout=$(readlink -f -- "$checkout")
      [[ "$checkout" != *,* ]] || fail 'Resolved package paths containing commas are not supported.'
      container_path="/opt/pi-packages/git/$package_id"
      if [[ "$packages" != *"$container_path"$'\n'* ]]; then
        run_args+=(--mount "type=bind,source=$checkout,target=$container_path,readonly")
        packages+="$container_path"$'\n'
      fi
      ;;
    *) packages+="$source"$'\n' ;;
  esac
done 3< "$repo_dir/pi-packages.txt"
run_args+=(--env "PI_SANDBOX_PACKAGES=$packages" --env "PI_SANDBOX_REBUILD=$rebuild")

if "$rebuild"; then
  docker build --pull --no-cache --tag "$image" "$repo_dir"
elif ! docker image inspect "$image" >/dev/null 2>&1; then
  docker build --tag "$image" "$repo_dir"
fi

if "$shell"; then
  run_args+=(--entrypoint /bin/bash)
fi

exec docker run "${run_args[@]}" "$image" "$@"
